{
  "name": "@qr-tracker/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/ensure-dev-vars.mjs",
    "dev": "wrangler d1 migrations apply qr-tracker-db --local && wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "pretypecheck": "node ./scripts/ensure-dev-vars.mjs && wrangler types",
    "typecheck": "tsc --noEmit",
    "pretest": "node ./scripts/ensure-dev-vars.mjs && wrangler types",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@qr-tracker/shared": "workspace:*",
    "hono": "4.13.10",
    "isbot": "5.2.2",
    "ua-parser-js": "1.0.41",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.0",
    "@types/node": "24.19.0",
    "@types/ua-parser-js": "0.7.39",
    "@vitest/coverage-istanbul": "4.1.11",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  }
}
