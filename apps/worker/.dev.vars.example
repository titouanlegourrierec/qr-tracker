# Copied to .dev.vars automatically by `pnpm dev` if .dev.vars is missing.
# Turnstile test secret ("always passes") — safe to commit, works with the test sitekey.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Local-only admin token for the kill-switch endpoints.
ADMIN_TOKEN=dev-admin-token
# Local web app (vite dev), where "/" and "/report" on the worker redirect.
WEB_APP_URL=http://localhost:5173/qr-tracker/
# Origins allowed to call the API locally: vite dev (5173) and vite preview (4173, E2E).
# Production allows only the GitHub Pages origin (wrangler.jsonc).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Optional Google Safe Browsing key (docs/DEPLOYMENT.md §11). Unset = check skipped.
# SAFE_BROWSING_API_KEY=
