{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qr-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true,
    "logs": {
      // Invocation logs record every request (headers, cf geolocation…) for 3 days, which
      // would break the "no IP or user-agent is ever logged" promise. Our own structured
      // console logs (src/lib/log.ts) carry no personal data and stay on.
      "enabled": true,
      "invocation_logs": false,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qr-tracker-db",
      // Replace with the ID printed by `wrangler d1 create qr-tracker-db`
      // (see docs/DEPLOYMENT.md). Any placeholder works for local dev and tests.
      "database_id": "efa826b2-cb46-416c-b124-370ee91bddfd",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    // Daily at 03:10 UTC: rotate salts, purge old scans, clean rate-limit windows.
    "crons": ["10 3 * * *"],
  },
  "vars": {
    // localhost:5173 = vite dev, localhost:4173 = vite preview (Playwright E2E).
    "ALLOWED_ORIGINS": "https://titouanlegourrierec.github.io,http://localhost:5173,http://localhost:4173",
    "RETENTION_DAYS": "365",
    // The web app, where "/" and "/report" on this worker redirect.
    "WEB_APP_URL": "https://titouanlegourrierec.github.io/qr-tracker/",
    // Destination check against Google Safe Browsing on create/edit. Only active once the
    // SAFE_BROWSING_API_KEY secret is set (docs/DEPLOYMENT.md §11); "false" turns it off.
    "URL_REPUTATION_ENABLED": "true",
  },
  // Secrets (wrangler secret put / .dev.vars): TURNSTILE_SECRET_KEY, ADMIN_TOKEN,
  // optional SAFE_BROWSING_API_KEY
}
